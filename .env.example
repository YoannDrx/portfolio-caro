# ============================================
# Environment Setup Instructions
# ============================================
# This file shows the structure for .env (production) and .env.local (development)
#
# PRODUCTION (.env):
#   - Used by Vercel runtime and migration commands
#   - Points to Neon branch "main"
#
# DEVELOPMENT (.env.local):
#   - Used locally by Next.js and `pnpm db:seed`
#   - Points to Neon branch "dev"
#   - Gitignored (create it locally)
#
# Setup:
# 1. Copy this file to .env (with production URLs)
# 2. Create .env.local (with dev URLs)
# 3. Get URLs from: neonctl connection-string [branch] --pooled / --direct

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:..."
DIRECT_URL="postgresql://neondb_owner:..."

# Site Configuration
NEXT_PUBLIC_SITE_URL="https://synck-psi.vercel.app"

# Email (Resend)
RESEND_API_KEY="re_..."

# Vercel Blob (Optional, for image uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# Emergency-only escape hatch. Keep image optimization enabled in production.
# NEXT_PUBLIC_IMAGE_OPTIMIZATION_DISABLED="true"

# Better Auth (Required)
BETTER_AUTH_SECRET="[generate with: openssl rand -base64 32]"

# Better Auth (optional explicit origins, comma-separated, no wildcards)
BETTER_AUTH_TRUSTED_ORIGINS="https://synck-psi.vercel.app"

# One-time manual admin bootstrap only. Do not keep these in Vercel.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="[20+ characters; inject securely]"
# CONFIRM_SESSION_INVALIDATION="INVALIDATE_ADMIN_SESSIONS"

# Destructive content seed protection (development/test only).
# ALLOW_CONTENT_SEED="1"
# SEED_TARGET="development"
